#include <stdio.h>
#include <math.h>

int main() {
    long long n;
    int decimalNum = 0, i = 0, remainder;
    printf("Enter binary number: ");
    scanf("%lld", &n);

    while (n != 0) {
        remainder = n % 10;
        n /= 10;
        decimalNum += remainder * pow(2, i);
        ++i;
    }
    printf("Decimal: %d\n", decimalNum);
    return 0;
}
