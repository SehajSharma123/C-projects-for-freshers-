#include <stdio.h>
#include <string.h>

struct Product {
    int id;
    char name[30];
    int quantity;
};

int main() {
    struct Product inventory[3] = {{1, "Pen", 100}, {2, "Paper", 50}, {3, "Ink", 20}};
    int searchID, found = 0;

    printf("Enter Product ID to check stock: ");
    scanf("%d", &searchID);

    for(int i = 0; i < 3; i++) {
        if(inventory[i].id == searchID) {
            printf("Product: %s | Stock: %d\n", inventory[i].name, inventory[i].quantity);
            found = 1;
            break;
        }
    }
    if(!found) printf("Product not found.\n");
    return 0;
}
